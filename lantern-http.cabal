cabal-version: 2.4
name: lantern-http
version: 0.1.0
synopsis: Strict incremental HTTP/1 wire protocol library
license: MIT
license-file: LICENSE
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules: Lantern.HTTP, Lantern.HTTP.Representation, Lantern.HTTP.Encoding
  build-depends: base >=4.18 && <5, bytestring, time
  ghc-options: -Wall -Wcompat -O2
  default-language: Haskell2010

test-suite protocol
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Protocol.hs
  build-depends: base, lantern-http, bytestring, QuickCheck
  ghc-options: -Wall
  default-language: Haskell2010

test-suite representation
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Representation.hs
  build-depends: base, lantern-http, bytestring, time, QuickCheck
  ghc-options: -Wall
  default-language: Haskell2010

benchmark fragmented
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Fragmented.hs
  build-depends: base, lantern-http, bytestring
  ghc-options: -Wall -O2 -rtsopts
  default-language: Haskell2010
